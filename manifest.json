{
  "manifest_version": 3,
  "name": "Slackメッセージ作成ヘルパー",
  "version": "1.0.0",
  "description": "初動対応・一次対応結果のSlack報告メッセージをサイドパネルから作成します。",
  "permissions": ["sidePanel"],
  "action": {
    "default_title": "Slackメッセージ作成ヘルパー"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
